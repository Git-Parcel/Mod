{
  "name": "gitparcel-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run check-i18n && npm run check-errors && npm test && vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "check-i18n": "node scripts/check-i18n.mjs",
    "check-errors": "node scripts/check-error-codes.mjs",
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite",
    "preview": "vite preview",
    "mock": "node scripts/mock-server.mjs"
  },
  "dependencies": {
    "naive-ui": "^2.45.3",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.0.0"
  }
}
